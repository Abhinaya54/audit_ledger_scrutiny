# Copy this to .env.local for local development
# For Vercel: set VITE_API_URL in the project environment variables
# pointing to your deployed backend (e.g. on Render).
# When set, requests are sent directly to the backend URL. Otherwise, 
# the /api proxy configured in vercel.json is used.

# VITE_API_URL=https://your-backend.onrender.com
